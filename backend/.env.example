# Copy to backend/.env and fill in values (never commit backend/.env).
# Synthetic stack: scripts/run_synthetic_stack.sh sources this file before
# `npm --prefix frontend run build`, so set NEXT_PUBLIC_* here first.

DATABASE_URL=sqlite+aiosqlite:///./autopulse.db

# Raw HTTP events (embedded / synthetic stack)
AUTOPULSE_EVENT_STORE=duckdb
AUTOPULSE_DUCKDB_PATH=./.autopulse/events.duckdb

# Dashboard magic link (file provider writes under repo .autopulse/emails in dev)
DASHBOARD_AUTH_ALLOWED_EMAIL=you@example.com
ALERT_EMAIL_PROVIDER=file
ALERT_EMAIL_FILE_OUTBOX_DIR=./.autopulse/emails
ALERT_EMAIL_FROM=alerts@example.com

# Optional: embedded static UI — usually supplied by repo-root .env.autopulse after first SDK boot
# NEXT_PUBLIC_AUTOPULSE_API_BASE_URL=/autopulse
# NEXT_PUBLIC_AUTOPULSE_API_KEY=…
# AUTOPULSE_EMBEDDED_API_KEY=…

# Optional: custom .env.autopulse path (default ./.env.autopulse)
# AUTOPULSE_ENV_AUTOPULSE_FILE=/path/to/.env.autopulse
# AUTOPULSE_EMBEDDED_API_KEY=
# AUTOPULSE_EMBEDDED_API_KEY_FILE=   # legacy single-line key file only
# AUTOPULSE_EMBEDDED_STARTUP_INGEST=1
