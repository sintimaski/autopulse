# Copy to backend/.env and fill in values (never commit backend/.env).
# Synthetic stack: scripts/run_synthetic_stack.sh sources this file before
# `npm --prefix frontend run build`, so set NEXT_PUBLIC_* here first.
#
# Local / uvicorn: the backend loads this file automatically when it exists
# next to this package (repo ``backend/.env``) or set AUTOPULSE_BACKEND_DOTENV to an absolute path.

# Relational DB (projects, keys, dashboard metadata). Path is anchored to repo root / AUTOPULSE_DATA_DIR
# (see normalize_database_url); keep alongside DuckDB under .autopulse/.
DATABASE_URL=sqlite+aiosqlite:///./.autopulse/autopulse.db
# Multi-replica production: run migrations once as a deploy step, then set to false on API replicas.
# DATABASE_RUN_MIGRATIONS_ON_STARTUP=false

# Raw HTTP events (local / synthetic stack)
AUTOPULSE_EVENT_STORE=duckdb
AUTOPULSE_EVENT_PLANE_MODE=duckdb_single_writer
# Relative paths are anchored to the repo root (parent of backend/), not process cwd.
# Prefer an absolute path in production. Override anchor with AUTOPULSE_DATA_DIR if needed.
# Relative paths anchor to data root (AUTOPULSE_DATA_DIR / AUTOPULSE_PROJECT_ROOT, else monorepo root).
# Prefer an absolute path in production. See resolve_autopulse_data_root in core/config.py.
AUTOPULSE_DUCKDB_PATH=.autopulse/events.duckdb
# Plan B (duckdb_log_shards): append-only shard storage root.
# Relative paths are anchored to data root (same as AUTOPULSE_DUCKDB_PATH).
AUTOPULSE_EVENT_PLANE_SHARDS_PATH=.autopulse/events-log
# Plan B compactor snapshot output root.
AUTOPULSE_EVENT_PLANE_SNAPSHOTS_PATH=.autopulse/events-duckdb
# Optional phase-1 cold export (DuckDB -> partitioned Parquet):
# AUTOPULSE_PARQUET_EXPORT_ENABLED=true
# AUTOPULSE_PARQUET_EXPORT_ROOT=.autopulse/parquet/events
# AUTOPULSE_PARQUET_EXPORT_INTERVAL_SECONDS=300
# AUTOPULSE_PARQUET_EXPORT_WINDOW_SECONDS=900
# Optional Plan B knobs (kept conservative by default):
# AUTOPULSE_SHARD_MAX_BYTES=134217728
# AUTOPULSE_SHARD_MAX_AGE_SECONDS=300
# AUTOPULSE_COMPACTOR_INTERVAL_SECONDS=60
# AUTOPULSE_COMPACTOR_MAX_CONCURRENCY=1
# AUTOPULSE_COMPACTOR_MAX_SHARDS_PER_RUN=1024
# AUTOPULSE_COMPACTOR_PUBLISH_TIMEOUT_SECONDS=60
# AUTOPULSE_SNAPSHOT_RETENTION_COUNT=3
# AUTOPULSE_EVENT_PLANE_BACKPRESSURE_MIN_FREE_BYTES=536870912
# AUTOPULSE_EVENT_PLANE_BACKPRESSURE_MIN_FREE_PERCENT=5
# AUTOPULSE_EVENT_PLANE_BACKPRESSURE_MAX_PENDING_SHARDS=20000
# AUTOPULSE_DATA_DIR=/srv/autopulse

# Scheduler defaults:
# - Local default SQLite filename (.autopulse/autopulse.db) auto-enables scheduler when unset.
# - Non-default SQLite/Postgres should set JOBS_ENABLE_SCHEDULER=true explicitly (or run external cron jobs).
# JOBS_ENABLE_SCHEDULER=true

# Production topology baseline (recommended explicit values):
# AUTOPULSE_ENV=production
# AUTOPULSE_EVENT_STORE=duckdb
# AUTOPULSE_EVENT_PLANE_MODE=duckdb_single_writer
# JOBS_ENABLE_SCHEDULER=true
# DASHBOARD_AUTH_ENABLED=true
# DASHBOARD_ENFORCE_ORIGIN_FOR_MUTATIONS=true
# DASHBOARD_REALTIME_BUS_BACKEND=postgres_notify  # set "none" for single-replica + sticky WS
# DATABASE_RUN_MIGRATIONS_ON_STARTUP=false        # run one-shot migration before scaling replicas

# Dashboard read/query protection for expensive endpoints (set 0 to disable):
# DASHBOARD_READ_RATE_LIMIT_REQUESTS_PER_WINDOW=120
# DASHBOARD_READ_RATE_LIMIT_WINDOW_SECONDS=60
# Optional cross-replica WS propagation on Postgres:
# DASHBOARD_REALTIME_BUS_BACKEND=postgres_notify
# DASHBOARD_REALTIME_BUS_CHANNEL=autopulse_dashboard_realtime

# Optional dashboard frontend RUM ingest guardrails (`POST /autopulse/rum`):
# DASHBOARD_RUM_MAX_REQUEST_BYTES=8192
# DASHBOARD_RUM_LOG_PAYLOADS=false

# Browser origins allowed for credentialed dashboard calls (include every host:port you open the UI on).
# Default in code also allows 8000/8000; override if you use other ports.
# CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8000

# Dashboard magic link — use the SAME email you type on the sign-in screen (or use DASHBOARD_ALLOWED_EMAIL_DOMAINS).
# For local dev without email delivery, set DASHBOARD_AUTH_MAGIC_LINK_DEV_EXPOSE_TOKEN=true to get a link in the UI.
DASHBOARD_AUTH_ALLOWED_EMAIL=you@example.com
ALERT_EMAIL_PROVIDER=file
# Relative paths are anchored to the project/data root (see resolve_autopulse_data_root), not cwd.
ALERT_EMAIL_FILE_OUTBOX_DIR=./.autopulse/emails
ALERT_EMAIL_FROM=alerts@example.com
# DASHBOARD_AUTH_MAGIC_LINK_DEV_EXPOSE_TOKEN=true

# Optional: static UI env bundle — often repo-root .env.autopulse for Next builds
# NEXT_PUBLIC_AUTOPULSE_API_BASE_URL=/autopulse
# NEXT_PUBLIC_AUTOPULSE_API_KEY=…

# Optional: custom .env.autopulse path (default ./.env.autopulse)
# AUTOPULSE_ENV_AUTOPULSE_FILE=/path/to/.env.autopulse
