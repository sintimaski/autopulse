# Same-origin static UI: path to mounted API (e.g. /lumonox). Next sidecar: full URL is best; if you keep /lumonox,
# set NEXT_PUBLIC_LUMONOX_DEV_API_ORIGIN to the FastAPI origin (default http://127.0.0.1:8000) — see next.config.ts.
NEXT_PUBLIC_LUMONOX_API_BASE_URL=/lumonox
# NEXT_PUBLIC_LUMONOX_DEV_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_LUMONOX_API_KEY=ap_live_embeddedlocal_localdevsecret
# Sidecar / LAN: comma-separated hostnames (no scheme) for Next dev HMR (see next.config.ts).
# LUMONOX_NEXT_ALLOWED_DEV_ORIGINS=192.168.0.144
