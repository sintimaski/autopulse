# Same-origin static UI: path to mounted API (e.g. /autopulse). Next sidecar: full URL is best; if you keep /autopulse,
# set NEXT_PUBLIC_AUTOPULSE_DEV_API_ORIGIN to the FastAPI origin (default http://127.0.0.1:8000) — see next.config.ts.
NEXT_PUBLIC_AUTOPULSE_API_BASE_URL=/autopulse
# NEXT_PUBLIC_AUTOPULSE_DEV_API_ORIGIN=http://127.0.0.1:8000
NEXT_PUBLIC_AUTOPULSE_API_KEY=ap_live_embeddedlocal_localdevsecret
# Sidecar / LAN: comma-separated hostnames (no scheme) for Next dev HMR (see next.config.ts).
# AUTOPULSE_NEXT_ALLOWED_DEV_ORIGINS=192.168.0.144
